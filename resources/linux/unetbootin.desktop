[Desktop Entry]
Version=1.0
Type=Application
Name=UNetbootin
GenericName=Bootable USB Creator
Comment=Create bootable USB drives from ISO files
Exec=/usr/bin/unetbootin-python %F
Icon=/usr/share/icons/hicolor/256x256/apps/unetbootin-python.png
Terminal=false
Categories=Utility;
StartupNotify=true
StartupWMClass=unetbootin-python
MimeType=application/x-iso;application/x-cd-image;
Keywords=usb;boot;iso;install;live;
