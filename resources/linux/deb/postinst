#!/bin/bash
# Post-installation script for PyNetboot DEB package
set -e

# Update desktop database
if [ -x "$(command -v update-desktop-database)" ]; then
    update-desktop-database -q || true
fi

# Update icon cache
if [ -x "$(command -v gtk-update-icon-cache)" ]; then
    gtk-update-icon-cache -f -q /usr/share/icons/hicolor || true
fi

# Re-index AppStream metadata. Without this the software centre keeps
# showing the bare dpkg entry -- package name, generic icon, "Unknown
# License" -- because it never picks up the metainfo this package just
# installed. The subcommand was renamed across AppStream versions, so try
# both; failure here must never break the install.
if [ -x "$(command -v appstreamcli)" ]; then
    appstreamcli refresh --force >/dev/null 2>&1 \
        || appstreamcli refresh-cache --force >/dev/null 2>&1 \
        || true
fi

exit 0
