{
    "app-id": "com.unetbootin.UNetbootin",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "24.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "unetbootin-python",
    "finish-args": [
        "--device=all",
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=x11",
        "--filesystem=host",
        "--filesystem=/usr/share/fonts:ro",
        "--filesystem=/usr/local/share/fonts:ro",
        "--filesystem=/var/cache/fontconfig:ro",
        "--filesystem=xdg-config/fontconfig:ro",
        "--filesystem=xdg-data/fonts:ro",
        "--filesystem=~/.fonts:ro",
        "--filesystem=/etc/fonts:ro",
        "--filesystem=xdg-cache/fontconfig:ro"
    ],
    "cleanup": [
        "/.local/share",
        "/.cache"
    ],
    "modules": [
        {
            "name": "unetbootin",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app . py7zr",
                "install -d /app/share/fonts/customtkinter",
                "find /app -type d -path '*/customtkinter/assets/fonts' -exec cp -r {}/. /app/share/fonts/customtkinter/ \\;",
                "test -n \"$(find /app/share/fonts -name '*.ttf' -print -quit)\" || (echo 'FATAL: Roboto was not bundled into /app/share/fonts' >&2; exit 1)",
                "fc-cache -f /app/share/fonts || true"
            ],
            "build-options": {
                "build-args": [
                    "--share=network"
                ],
                "env": {
                    "PIP_NO_WARN_SCRIPT_LOCATION": "1"
                }
            },
            "sources": [
                {
                    "type": "file",
                    "path": "../../requirements.txt"
                },
                {
                    "type": "dir",
                    "path": "../../src",
                    "dest": "src"
                },
                {
                    "type": "file",
                    "path": "../../setup.py"
                }
            ]
        },
        {
            "name": "resources",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm644 -t /app/share/unetbootin/resources/bootloader resources/bootloader/*",
                "install -Dm644 -t /app/share/unetbootin/resources/icons resources/icons/*",
                "install -Dm644 -t /app/share/unetbootin/resources/logos resources/logos/*"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../../src/unetbootin/resources",
                    "dest": "resources"
                }
            ]
        },
        {
            "name": "desktop-integration",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm644 com.unetbootin.UNetbootin.desktop /app/share/applications/com.unetbootin.UNetbootin.desktop",
                "install -Dm644 com.unetbootin.UNetbootin.appdata.xml /app/share/metainfo/com.unetbootin.UNetbootin.appdata.xml",
                "install -Dm644 resources/icons/unetbootin_256.png /app/share/icons/hicolor/256x256/apps/com.unetbootin.UNetbootin.png",
                "install -Dm644 resources/icons/unetbootin_48.png /app/share/icons/hicolor/48x48/apps/com.unetbootin.UNetbootin.png",
                "install -Dm644 resources/icons/unetbootin_32.png /app/share/icons/hicolor/32x32/apps/com.unetbootin.UNetbootin.png",
                "install -Dm644 resources/icons/unetbootin_16.png /app/share/icons/hicolor/16x16/apps/com.unetbootin.UNetbootin.png"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "com.unetbootin.UNetbootin.desktop"
                },
                {
                    "type": "file",
                    "path": "com.unetbootin.UNetbootin.appdata.xml"
                },
                {
                    "type": "dir",
                    "path": "../../src/unetbootin/resources/icons",
                    "dest": "resources/icons"
                }
            ]
        }
    ]
}
